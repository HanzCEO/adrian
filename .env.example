# Adrian runtime configuration.
#
# Copy this file to `.env` next to docker/docker-compose.yml and edit as needed.
# Every value here has a working default for a local single-user install.

# ---------------------------------------------------------------------------
# Adrian daemon
# ---------------------------------------------------------------------------

# Address the HTTP server binds to inside the container.
ADRIAN_BIND=0.0.0.0:38922

# Host port published by docker compose. Change this if 38922 is taken.
ADRIAN_PORT=38922

# SQLite database file. Mounted as a named volume in compose.
ADRIAN_DB_PATH=/data/adrian.db

# Base URLs of the two dependencies. These defaults are for running the binary directly
# on a host. docker/docker-compose.yml overrides both with container addresses on the
# internal network, so you do not need to change anything there.
ADRIAN_QDRANT_URL=http://127.0.0.1:6333
ADRIAN_EMBEDDER_URL=http://127.0.0.1:8081

# Qdrant collection holding chunk vectors. One collection per model version.
ADRIAN_COLLECTION=adr_chunks__uibk_v1

# Static bearer token required on every /v1 route. Empty disables authentication.
# v0.1.0 is meant for a single user on a private network; set this if you expose the port.
ADRIAN_API_TOKEN=

# Static bearer token for /mcp. Empty means /mcp follows ADRIAN_API_TOKEN.
ADRIAN_MCP_TOKEN=

# Run the background embed worker inside this process. Set to 0 to run a read-only node.
ADRIAN_WORKER=1

# Maximum accepted request body size, in bytes. Default is 4 MiB.
ADRIAN_MAX_BODY_BYTES=4194304

# `tracing` filter directive: error, warn, info, debug, trace, or a per-crate directive.
ADRIAN_LOG=info

# ---------------------------------------------------------------------------
# Embedding model
# ---------------------------------------------------------------------------

# The model this daemon expects the engine to serve. Adrian refuses to start when the
# engine reports a different model or version, because comparing vectors from two models
# produces plausible nonsense rather than an error.
ADRIAN_EMBED_MODEL=uibk-embedding-v1
ADRIAN_EMBED_VERSION=1

# ---------------------------------------------------------------------------
# Embedding engine container
# ---------------------------------------------------------------------------

EMBEDDER_BIND=0.0.0.0:8081
ADRIAN_WEIGHTS_DIR=./embedder/weights
RUST_LOG=info
