{
  "title": "Choose a test assertion style",
  "template": "madr",
  "decided_on": "2024-09-03",
  "status_raw": "accepted",
  "status": "accepted",
  "decision_makers": [],
  "consulted": [],
  "informed": [],
  "extra": {},
  "sections": [
    {
      "kind": "context",
      "raw_heading": "Context and Problem Statement",
      "ordinal": 0,
      "parent": null,
      "text": "\nAssertions are written three different ways across the codebase.\n\n",
      "option_key": null,
      "byte_start": 76,
      "byte_end": 176
    },
    {
      "kind": "drivers",
      "raw_heading": "Decision Drivers",
      "ordinal": 1,
      "parent": null,
      "text": "\n* Readability for people reviewing a failing test\n* Partial string matching, which the standard library does not offer\n\n",
      "option_key": null,
      "byte_start": 176,
      "byte_end": 317
    },
    {
      "kind": "options",
      "raw_heading": "Considered Options",
      "ordinal": 2,
      "parent": null,
      "text": "\n* Plain JUnit5 assertions\n* AssertJ\n* Hamcrest\n\n",
      "option_key": null,
      "byte_start": 317,
      "byte_end": 388
    },
    {
      "kind": "outcome",
      "raw_heading": "Decision Outcome",
      "ordinal": 3,
      "parent": null,
      "text": "\nChosen option: “AssertJ”, because it offers fluent assertions and partial string matching.\n\n",
      "option_key": null,
      "byte_start": 388,
      "byte_end": 505
    },
    {
      "kind": "consequences",
      "raw_heading": "Consequences",
      "ordinal": 4,
      "parent": 3,
      "text": "\n* Good, because failure messages name the expectation and the actual value\n* Bad, because it is another dependency\n\n",
      "option_key": null,
      "byte_start": 505,
      "byte_end": 639
    },
    {
      "kind": "pros_cons",
      "raw_heading": "Pros and Cons of the Options",
      "ordinal": 5,
      "parent": null,
      "text": "\n",
      "option_key": null,
      "byte_start": 639,
      "byte_end": 672
    },
    {
      "kind": "pros_cons",
      "raw_heading": "Plain JUnit5 assertions",
      "ordinal": 6,
      "parent": 5,
      "text": "\n* Good, because no extra dependency\n* Bad, because there is no partial string matching\n\n",
      "option_key": "opt:plain junit5 assertions",
      "byte_start": 672,
      "byte_end": 789
    },
    {
      "kind": "pros_cons",
      "raw_heading": "AssertJ",
      "ordinal": 7,
      "parent": 5,
      "text": "\n* Good, because it offers fluent assertions\n* Good, because it allows partial string testing\n* Neutral, because it is a large library but a well known one\n* Bad, because assertions are less obvious to readers new to it\n\n",
      "option_key": "opt:assertj",
      "byte_start": 789,
      "byte_end": 1022
    },
    {
      "kind": "pros_cons",
      "raw_heading": "Hamcrest – the older alternative",
      "ordinal": 8,
      "parent": 5,
      "text": "\n* Good, because it composes matchers well\n* Bad, because the failure messages are worse than AssertJ's\n",
      "option_key": "opt:hamcrest - the older alternative",
      "byte_start": 1022,
      "byte_end": 1165
    }
  ],
