  "sections": [
    {
      "kind": "context",
      "raw_heading": "Context and Problem Statement",
      "ordinal": 0,
      "parent": null,
      "text": "\nWe need durable relational storage for billing records, with transactional guarantees\nacross multiple tables.\n\n",
      "option_key": null,
      "byte_start": 42,
      "byte_end": 187
    },
    {
      "kind": "options",
      "raw_heading": "Considered Options",
      "ordinal": 1,
      "parent": null,
      "text": "\n* Postgres\n* SQLite\n* MySQL\n\n",
      "option_key": null,
      "byte_start": 187,
      "byte_end": 239
    },
    {
      "kind": "outcome",
      "raw_heading": "Decision Outcome",
      "ordinal": 2,
      "parent": null,
      "text": "\nChosen option: \"Postgres\", because it is the only candidate that gives us transactional\nDDL and a managed offering our operations team already runs.\n\n",
      "option_key": null,
      "byte_start": 239,
      "byte_end": 410
    },
    {
      "kind": "consequences",
      "raw_heading": "Consequences",
      "ordinal": 3,
      "parent": 2,
      "text": "\n* Good, because the operations team has run it for years\n* Bad, because it is one more service to keep patched\n",
      "option_key": null,
      "byte_start": 410,
      "byte_end": 539
    }
  ],
